# Aptos Stale Repos: Letter A
# ═══════════════════════════════════════════════════════════════════════════════
# These repos have not been updated since 2024. They remain as topological
# reference points in the Aptos world but are not included in active random walks.
#
# To revive: update pushedAt > 2025-01-01 and move to seed_bundles_2025.jl

[world]
name = "aptos"
letter = "a"
status = "stale"
cutoff = "2025-01-01"

[[repos]]
name = "Aptos-Unity-SDK"
url = "https://github.com/aptos-labs/Aptos-Unity-SDK"
