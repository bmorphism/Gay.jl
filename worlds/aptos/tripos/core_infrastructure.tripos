# TRIPOS: Core Infrastructure (Triads 1-5)
# ═══════════════════════════════════════════════════════════════════════════════
# Triad + Topos = Tripos: Topological structure with chromatic seed triads
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  SPECTRAL MIXING GUARANTEES                                                 │
# │                                                                             │
# │    λ₂(triad) = min color distance / √3                                     │
# │    Rapid mixing when λ₂ ≥ 0.69                                              │
# │    Walk order: highest λ₂ first for fastest convergence                    │
# └─────────────────────────────────────────────────────────────────────────────┘

[world]
name = "aptos"
category = "core_infrastructure"
status = "active"
updated_range = ["2025-12-06", "2025-12-12"]

[[triads]]
index = 1
names = ["keyless-zk-proofs", "aptos-core", "sign-in-with-aptos"]
urls = [
    "https://github.com/aptos-labs/keyless-zk-proofs",
    "https://github.com/aptos-labs/aptos-core",
    "https://github.com/aptos-labs/sign-in-with-aptos"
]
updated = ["2025-12-12", "2025-12-12", "2025-12-12"]
seed_formula = "splitmix64(GAY_SEED ⊕ hash(name) ⊕ 1)"
descriptions = [
    "Aptos Keyless ZK circuit implementation in circom",
    "Aptos layer 1 blockchain core",
    "Library of utilities for Sign in with Aptos"
]

