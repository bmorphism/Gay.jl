    given-names: Barton
    alias: bmorphism
type: software
license: MIT
repository-code: "https://github.com/bmorphism/Gay.jl"
url: "https://bmorphism.github.io/Gay.jl/"
keywords:
  - julia
  - colors
  - splittable-random
  - strong-parallelism-invariance
  - shannon-channel-capacity
  - benchmark
  - reproducibility
  - gf3
